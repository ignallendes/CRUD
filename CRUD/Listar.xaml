<Window x:Class="Listar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Listar" Height="450" Width="800">
    <Grid>
        <ComboBox x:Name="cbxTablas" HorizontalAlignment="Left" Margin="10,84,0,0" VerticalAlignment="Top" Width="120"/>
        <DataGrid x:Name="GrillaEmpleados" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,133,10,133"/>
        <Label x:Name="lblTablas" Content="Tablas" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btbAtras" Content="Atrás" HorizontalAlignment="Left" Margin="276,354,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
